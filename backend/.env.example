# Copy this file to .env and fill in real values. Never commit .env to GitHub.

# PostgreSQL connection string (Neon / Render PostgreSQL / local)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Web app address(es) allowed to call the API, comma-separated
CORS_ORIGIN=http://localhost:5173

PORT=4000

# Password given to the demo accounts by `npm run seed`
SEED_PASSWORD=Revive@2026
